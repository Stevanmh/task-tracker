# ─── Base de datos (SQL Server) ─────────────────────────────
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=TaskTrackerDb
DB_USER=sa
DB_PASSWORD=your_strong_password_here     # Mínimo 8 chars, mayúsculas + números + símbolos

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_minimum_32_characters_here
JWT_EXPIRY_HOURS=1

# ─── API ─────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# NOTA: La variable NEXT_PUBLIC_API_URL es para el frontend de Next.js
# y debe ir en frontend/.env.local (NO en este archivo).
# El backend no lee variables de frontend/, y Next.js no lee el .env raíz.
#
# Crear frontend/.env.local con:
#   NEXT_PUBLIC_API_URL=http://localhost:5000
# ─────────────────────────────────────────────────────────────
