JWT_REFRESH_EXPIRY_DAYS=7

# ─── API ─────────────────────────────────────────────────────
BACKEND_PORT=5000
CORS_ORIGIN=http://localhost:3000

# ─── Frontend ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000
