# ─── Base de datos (SQL Server) ─────────────────────────────
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=TaskTracker
DB_USER=sa
DB_PASSWORD=your_strong_password_here

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_minimum_32_characters_here
